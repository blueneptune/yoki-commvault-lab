# One file per CommCell: copy to config/<name>.env and run the lab
# scripts with <name> (default cv-toaster). Same format as blt's files.
#
# Give the lab a token of its own (Command Center). Renewal replaces the
# token pair on the CommServe, so a token copied from blt and renewed
# here locks blt out (and the other way round) - see the README.

# REST base URL, no trailing slash. Usually one of:
#   https://<webconsole-host>/commandcenter/api
#   https://<webconsole-host>/webconsole/api
#   http://<webserver-host>:81/SearchSvc/CVWebService.svc
CV_BASE_URL=https://commserve.example.com/commandcenter/api

# For Commvault Cloud (SaaS, formerly Metallic) instead:
#   CV_BASE_URL=https://api.metallic.io
#   CV_DEPLOYMENT=saas
# That switches the token header and applies an hourly call budget
# (SaaS tenants are rate-limited); CV_MAX_CALLS_PER_HOUR changes it.
# CV_DEPLOYMENT=software
# CV_MAX_CALLS_PER_HOUR=

# Credentials: either an access token (Command Center > your user >
# Access tokens), or a username and password. The token wins if both are set.
CV_ACCESS_TOKEN=
# With the refresh token alongside it, the lab renews the access
# token itself when it expires and REWRITES the CV_ACCESS_TOKEN,
# CV_REFRESH_TOKEN and CV_TOKEN_* lines of this file. Don't hand-edit
# those while a lab script is running.
CV_REFRESH_TOKEN=
# Maintained by the lab. RENEWABLE_UNTIL is the regeneration date:
# renewal stops working after it and a new token has to be created in
# Command Center. Runs start warning a week ahead.
CV_TOKEN_EXPIRES_AT=
CV_TOKEN_RENEWABLE_UNTIL=
CV_USERNAME=
CV_PASSWORD=

# TLS: point CV_CA_BUNDLE at a PEM file for a private CA, or set
# CV_VERIFY_TLS=false to skip verification entirely (needed for a
# self-signed certificate whose name doesn't match the host, e.g. the eval OVA).
CV_VERIFY_TLS=true
# CV_CA_BUNDLE=/etc/pki/tls/certs/commserve-ca.pem

# Optional tuning (defaults shown).
# CV_PAGE_SIZE=500
# CV_TIMEOUT_SECONDS=120
